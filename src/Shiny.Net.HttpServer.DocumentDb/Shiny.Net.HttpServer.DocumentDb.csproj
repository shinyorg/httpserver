<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Shiny.Net.HttpServer.DocumentDb</RootNamespace>
    <Description>REST and live-query (SSE) endpoints for Shiny.DocumentDb on Shiny.Net.HttpServer — a document type as a complete HTTP resource in one line, without ASP.NET Core, so it runs in a .NET MAUI app. Plain JSON, AOT-clean.</Description>
  </PropertyGroup>

  <!-- Analyzers on, like every other shipping project. The endpoints deliberately avoid the one
       thing that would forfeit that: nothing here reflects over a handler's parameters, because
       every route is mapped as a RequestDelegate that reads the context itself. -->

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <!-- The typed lane evaluates a request scope in memory with Shiny.DocumentDb's own interpreter —
       the same one the query layer uses, so the HTTP layer and the query layer can never disagree
       about what a scope means. That reaches us through the public Shiny.DocumentDb.Hosting surface
       (DocumentPredicate / DocumentFilter / DocumentStoreAccessor), which is why this is an ordinary
       PackageReference and not a cross-repo project reference with an InternalsVisibleTo behind it:
       the contract is versioned rather than silent, and the version floor is in
       Directory.Packages.props. -->
  <ItemGroup>
    <PackageReference Include="Shiny.DocumentDb" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Shiny.Net.HttpServer/Shiny.Net.HttpServer.csproj" />
  </ItemGroup>

</Project>
