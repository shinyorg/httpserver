<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Shiny.Net.HttpServer.Mcp</RootNamespace>
    <Description>Model Context Protocol (Streamable HTTP) transport for Shiny.Net.HttpServer. Hosts an MCP server anywhere this server runs — including inside a .NET MAUI app, where ASP.NET Core's MCP transport cannot go.</Description>
  </PropertyGroup>

  <!-- Analyzers on, same as every other shipping project — the defaults from src/Directory.Build.props
       apply and nothing is turned off here.

       This package used to opt out, on the grounds that the MCP SDK discovered tools by reflecting
       over attributes. That is no longer true of the shape we depend on: as of MCP SDK 2.0 and
       Microsoft.Extensions.AI 10.8, nothing in the dependency graph is annotated RequiresDynamicCode,
       and the generic WithTools<T>() overload carries DynamicallyAccessedMembers rather than
       RequiresUnreferencedCode. WithToolsFromAssembly() and the IEnumerable<Type> overloads are still
       annotated and are still the wrong call to make in a trimmed app.

       What does not survive trimming is JSON schema generation for a tool's parameter and return
       types, which needs a source-generated JsonSerializerContext. That failure is the caller's to
       make, and it already arrived at MapMcp() — as a bare NotSupportedException thrown from deep
       inside the container. MapMcp() now catches it and says what to add. -->

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Shiny.Net.HttpServer/Shiny.Net.HttpServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Shiny.Net.HttpServer.Tests" />
  </ItemGroup>

</Project>
