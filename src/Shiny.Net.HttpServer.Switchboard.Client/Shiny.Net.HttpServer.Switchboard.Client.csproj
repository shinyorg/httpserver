<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Shiny.Net.HttpServer.Switchboard.Client</RootNamespace>
    <Description>The .NET client for Shiny.Net.HttpServer.Switchboard: connect a line, handle calls from the server, call switchboard methods, stream results, answer the server's questions, and resume after a drop — over Server-Sent Events and plain HTTP. No dependency on the server package; runs in .NET MAUI, Blazor WebAssembly and console apps, trimmed or Native AOT.</Description>
    <PackageTags>$(PackageTags) switchboard realtime sse server-sent-events signalr client</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <!-- Shipped inside the package, as with the server's generator: [SwitchboardClient<,>] and the
       code it generates are one feature. -->
  <ItemGroup>
    <ProjectReference Include="../Shiny.Net.HttpServer.Switchboard.Client.SourceGenerators/Shiny.Net.HttpServer.Switchboard.Client.SourceGenerators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../Shiny.Net.HttpServer.Switchboard.Client.SourceGenerators/bin/$(Configuration)/netstandard2.0/Shiny.Net.HttpServer.Switchboard.Client.SourceGenerators.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Shiny.Net.HttpServer.Tests" />
  </ItemGroup>

</Project>
