<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Overrides src/Directory.Build.props: an analyzer loads into the compiler host, which is
         netstandard2.0, not into the app being compiled. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Shiny.Net.HttpServer.Mediator.SourceGenerators</RootNamespace>

    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <NoWarn>$(NoWarn);RS2008</NoWarn>

    <!-- Not a package of its own: Shiny.Net.HttpServer.Mediator packs this output under
         analyzers/dotnet/cs. The attributes and the generator that reads them are one feature, and
         shipping them separately only creates a way to reference half of it. -->
    <IsPackable>false</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <IncludeSymbols>false</IncludeSymbols>
    <IncludeSource>false</IncludeSource>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <!-- The trim/AOT analyzers inherited from src/Directory.Build.props do not apply to a
       compile-time-only assembly and would only produce noise. -->
  <PropertyGroup>
    <IsAotCompatible>false</IsAotCompatible>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
    <PackageReference Include="PolySharp" PrivateAssets="all" />
  </ItemGroup>

  <!-- Shared with the endpoint generator rather than copied. Route template syntax in particular
       has to stay identical between the two: [Route] and [MediatorHttpGet] accept the same
       templates, and two parsers that drifted would be a genuinely nasty bug to find. Only the
       helpers are linked — not the generator itself, which would emit everything twice. -->
  <ItemGroup>
    <Compile Include="../Shiny.Net.HttpServer.SourceGenerators/RouteTemplateInfo.cs" Link="Shared/RouteTemplateInfo.cs" />
    <Compile Include="../Shiny.Net.HttpServer.SourceGenerators/EndpointModel.cs" Link="Shared/EndpointModel.cs" />
    <Compile Include="../Shiny.Net.HttpServer.SourceGenerators/TypeAnalysis.cs" Link="Shared/TypeAnalysis.cs" />
    <Compile Include="../Shiny.Net.HttpServer.SourceGenerators/EquatableArray.cs" Link="Shared/EquatableArray.cs" />
    <Compile Include="../Shiny.Net.HttpServer.SourceGenerators/DiagnosticInfo.cs" Link="Shared/DiagnosticInfo.cs" />
  </ItemGroup>

</Project>
