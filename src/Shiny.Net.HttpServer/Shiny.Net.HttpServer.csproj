<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RootNamespace>Shiny.Net.HttpServer</RootNamespace>
        <Description>A dependency-light, AOT-friendly HTTP server for .NET. Runs anywhere .NET runs, including .NET MAUI, where ASP.NET Core cannot.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
        <PackageReference Include="Microsoft.Extensions.Primitives"/>
    </ItemGroup>

    <!-- The typed-endpoint generator ships inside this package rather than beside it. The [Route],
         [Get], [Post] … attributes live here, and the generator is what turns them into a
         MapXxxEndpoints() call — one feature in one package, so there is no second reference to
         forget and no way to end up with attributes that silently do nothing. -->
    <ItemGroup>
        <ProjectReference Include="../Shiny.Net.HttpServer.SourceGenerators/Shiny.Net.HttpServer.SourceGenerators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="../Shiny.Net.HttpServer.SourceGenerators/bin/$(Configuration)/netstandard2.0/Shiny.Net.HttpServer.SourceGenerators.dll"
              Pack="true"
              PackagePath="analyzers/dotnet/cs"
              Visible="false"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Shiny.Net.HttpServer.Tests"/>

        <!-- The SSH provider needs the loopback listener: SSH remote forwarding delivers to a
             host:port, so the tunnel owns a private loopback socket rather than making the app
             bind one of its own. -->
        <InternalsVisibleTo Include="Shiny.Net.HttpServer.Ssh"/>

        <!-- WebDAV maps request paths onto a real directory, which is the same job the static file
             handler and the file browser do. It reuses StaticFilePath rather than growing a second
             traversal check: one implementation that everything goes through is the security model,
             and a copy of it is a copy that will drift. -->
        <InternalsVisibleTo Include="Shiny.Net.HttpServer.WebDav"/>
    </ItemGroup>

</Project>
