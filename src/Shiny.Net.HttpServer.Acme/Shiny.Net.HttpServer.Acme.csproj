<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Shiny.Net.HttpServer.Acme</RootNamespace>
    <Description>Automatic TLS certificates for Shiny.Net.HttpServer from Let's Encrypt, ZeroSSL or any ACME (RFC 8555) CA — issued, stored, renewed and hot-swapped into the running server, with HTTP-01 and TLS-ALPN-01 answered by the server itself. Built on in-box cryptography only: no BouncyCastle, no Certes, and trim- and AOT-clean.</Description>
    <PackageTags>$(PackageTags) acme letsencrypt zerossl tls certificates rfc8555</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Shiny.Net.HttpServer/Shiny.Net.HttpServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Shiny.Net.HttpServer.Tests" />
  </ItemGroup>

</Project>
