<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Shiny.Net.HttpServer.Grpc</RootNamespace>
    <Description>gRPC and gRPC-Web for Shiny.Net.HttpServer — unary, client-streaming, server-streaming and bidirectional methods served over the same HTTP/2 stack, callable from Grpc.Net.Client, grpcurl or a browser, without ASP.NET Core. Serialization is supplied by the caller, so nothing here reflects over your messages and the whole path stays trim- and AOT-clean.</Description>
    <PackageTags>$(PackageTags) grpc grpc-web http2 rpc protobuf</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Shiny.Net.HttpServer/Shiny.Net.HttpServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Shiny.Net.HttpServer.Tests" />
  </ItemGroup>

</Project>
