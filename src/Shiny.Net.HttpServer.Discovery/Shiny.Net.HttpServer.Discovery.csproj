<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Shiny.Net.HttpServer.Discovery</RootNamespace>
    <Description>mDNS/DNS-SD (Bonjour) discovery for Shiny.Net.HttpServer — advertises an embedded server on the local link and finds the ones other devices are advertising, so a phone, a desktop or a Raspberry Pi can reach each other without anyone typing an IP address.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Shiny.Net.Discovery" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Shiny.Net.HttpServer/Shiny.Net.HttpServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Shiny.Net.HttpServer.Tests" />
  </ItemGroup>

</Project>
