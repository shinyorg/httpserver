<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Shiny.Net.HttpServer.OAuthLoopback</RootNamespace>
    <Description>The loopback redirect receiver for OAuth 2.0 / OpenID Connect sign-in from native apps (RFC 8252) on Shiny.Net.HttpServer — the "a browser opens, you sign in, the app gets the code" flow desktop apps and CLIs use, on an ephemeral 127.0.0.1 port with state validation, form_post, timeouts and a customisable completion page. Not an OAuth client: PKCE and the token exchange stay with whichever client library you already use.</Description>
    <PackageTags>$(PackageTags) oauth oauth2 oidc openid rfc8252 loopback login</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Shiny.Net.HttpServer/Shiny.Net.HttpServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Shiny.Net.HttpServer.Tests" />
  </ItemGroup>

</Project>
