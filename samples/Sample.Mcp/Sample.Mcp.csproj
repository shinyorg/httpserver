<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Sample.Mcp</RootNamespace>
  </PropertyGroup>

  <!-- This sample is the AOT proof for MCP, same as the others are for the core server: it publishes
       with PublishAot and the tools below answer over the wire from the native binary. The tool
       parameters here are primitives, so no JsonSerializerContext is needed; see the docs for what
       to add when a tool takes or returns a complex type. -->

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Shiny.Net.HttpServer/Shiny.Net.HttpServer.csproj" />
    <ProjectReference Include="../../src/Shiny.Net.HttpServer.Mcp/Shiny.Net.HttpServer.Mcp.csproj" />
  </ItemGroup>

</Project>
