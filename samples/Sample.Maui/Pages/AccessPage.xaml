<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Sample.Maui.ViewModels"
             x:Class="Sample.Maui.Pages.AccessPage"
             x:DataType="vm:AccessViewModel"
             Title="Access">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">

            <Label Text="Who gets in" FontSize="20" FontAttributes="Bold" />

            <Label Text="Anyone opening the link is asked for these. A change takes effect on the very next request — the validator reads these values rather than a copy taken at startup, so nothing restarts."
                   TextColor="Gray"
                   FontSize="12" />

            <Border Stroke="{AppThemeBinding Light=#E5E5EA, Dark=#2C2C32}"
                    StrokeThickness="1"
                    Padding="16"
                    StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="10">

                    <Entry Placeholder="Username"
                           Text="{Binding Username}"
                           IsSpellCheckEnabled="False"
                           IsTextPredictionEnabled="False" />

                    <!-- Deliberately not masked: on a device you are handing a link to, someone has
                         to read this out. A product with real accounts would not show it. -->
                    <Entry Placeholder="Password"
                           Text="{Binding Password}"
                           IsSpellCheckEnabled="False"
                           IsTextPredictionEnabled="False" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0"
                                Text="Save"
                                Command="{Binding SaveCommand}"
                                IsEnabled="{Binding NotBusy}" />
                        <Button Grid.Column="1"
                                Text="New password"
                                Command="{Binding RegenerateCommand}"
                                IsEnabled="{Binding NotBusy}" />
                    </Grid>

                    <Label Text="{Binding StorageStatus}"
                           TextColor="Gray"
                           FontSize="12" />

                    <Label Text="{Binding LastError}"
                           TextColor="#D9534F"
                           IsVisible="{Binding HasError}" />

                </VerticalStackLayout>
            </Border>

            <Label Text="The password is generated on first run and kept in the device keychain. Failed attempts still show up on the Traffic tab — the log sits in front of authentication."
                   TextColor="Gray"
                   FontSize="12" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
