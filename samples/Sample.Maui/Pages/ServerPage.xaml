<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Sample.Maui.ViewModels"
             x:Class="Sample.Maui.Pages.ServerPage"
             x:DataType="vm:ServerViewModel"
             Title="Server">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">

            <Label Text="This phone is a web server"
                   FontSize="24"
                   FontAttributes="Bold" />

            <Label Text="Start it, share the link, and someone on the other side of the world can open a page served from here."
                   TextColor="Gray" />

            <!-- Status -->
            <Border Stroke="{AppThemeBinding Light=#E5E5EA, Dark=#2C2C32}"
                    StrokeThickness="1"
                    Padding="16"
                    StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="10">

                    <HorizontalStackLayout Spacing="8">
                        <Label Text="Status" TextColor="Gray" />
                        <Label Text="{Binding Status}" FontAttributes="Bold" />
                        <ActivityIndicator IsRunning="{Binding Busy}"
                                           IsVisible="{Binding Busy}"
                                           HeightRequest="16"
                                           WidthRequest="16" />
                    </HorizontalStackLayout>

                    <Label Text="{Binding LastError}"
                           TextColor="#D9534F"
                           IsVisible="{Binding HasError}" />

                    <!-- The public link. Bound, never captured once: a free tunnel hands out a new
                         address on every reconnect, and a phone reconnects whenever the network does. -->
                    <Label Text="Public link" TextColor="Gray" Margin="0,6,0,0" />
                    <Label Text="{Binding PublicUrl, TargetNullValue='Not shared yet'}"
                           LineBreakMode="CharacterWrap" />

                    <Label Text="On this network" TextColor="Gray" Margin="0,6,0,0" />
                    <Label Text="{Binding LocalUrl, TargetNullValue='Server not started'}"
                           LineBreakMode="CharacterWrap" />

                    <!-- The MCP endpoint, for pasting into an AI client. Same server, same password. -->
                    <Label Text="MCP endpoint" TextColor="Gray" Margin="0,6,0,0" />
                    <Label Text="{Binding McpUrl, TargetNullValue='Server not started'}"
                           LineBreakMode="CharacterWrap" />

                    <!-- The WebDAV mount. Finder: Go → Connect to Server. Explorer: Map network
                         drive. Same server, same password — the app's storage as a drive. -->
                    <Label Text="WebDAV mount" TextColor="Gray" Margin="0,6,0,0" />
                    <Label Text="{Binding WebDavUrl, TargetNullValue='Server not started'}"
                           LineBreakMode="CharacterWrap" />

                    <HorizontalStackLayout Spacing="8" Margin="0,6,0,0">
                        <Label Text="Requests served:" />
                        <Label Text="{Binding RequestCount}" FontAttributes="Bold" />
                        <Label Text="— see the Traffic tab" TextColor="Gray" />
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- Actions -->
            <VerticalStackLayout Spacing="10">
                <Button Text="Share publicly"
                        Command="{Binding ShareCommand}"
                        IsEnabled="{Binding NotBusy}" />

                <Button Text="Start on this network only"
                        Command="{Binding StartLocalCommand}"
                        IsEnabled="{Binding NotBusy}" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Grid.Column="0"
                            Text="Copy link"
                            Command="{Binding CopyLinkCommand}"
                            IsEnabled="{Binding HasPublicUrl}" />
                    <Button Grid.Column="1"
                            Text="Open"
                            Command="{Binding OpenLinkCommand}"
                            IsEnabled="{Binding HasPublicUrl}" />
                </Grid>

                <!-- Enabled while the tunnel is still opening, not just once it has an address.
                     Opening one takes seconds and can fail; without this the screen locks itself
                     out of every action for the duration of its own waiting. -->
                <Button Text="Stop sharing"
                        Command="{Binding StopSharingCommand}"
                        IsEnabled="{Binding CanStopSharing}" />
            </VerticalStackLayout>

            <Label Text="Endpoints: /  ·  /api/device  ·  /api/notes  ·  /files (browse app storage)  ·  /mcp (4 tools, for an AI client) — all behind the password. /ping is open."
                   TextColor="Gray"
                   FontSize="12" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
