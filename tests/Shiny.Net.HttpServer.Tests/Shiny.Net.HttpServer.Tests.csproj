<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Shiny.Net.HttpServer.Tests</RootNamespace>

    <!-- xunit v3 runs on Microsoft.Testing.Platform: the test assembly is its own runner, so
         `dotnet test` and running the executable directly do exactly the same thing. -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>

    <!-- Shiny.Mediator ships a generator that turns a contract carrying [Get]/[Post]/[Put]/
         [Patch]/[Delete] into a typed HTTP *client*. It matches those attributes by simple name
         with no namespace check, so it also fires on this server's own minimal-endpoint attributes
         and reports SHINYMED_HTTP001 against every one of them. The two features are unrelated;
         this project uses both, so the client generator's opinion about our attributes is turned
         off. Any app that mixes minimal endpoints with the mediator package needs the same line —
         it is called out in the mediator docs page. -->
    <NoWarn>$(NoWarn);SHINYMED_HTTP001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />

    <!-- MTP has no built-in trx writer; the report-trx option CI passes comes from this extension. -->
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />

    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />

    <!-- The MCP tests drive the endpoint with the SDK's own client, so the SDK is a test
         dependency in its own right and not just a transitive one. -->
    <PackageReference Include="ModelContextProtocol" />

    <!-- The gRPC tests drive the endpoints with Google's own client, which is the only way to know
         the wire format is right rather than merely self-consistent. -->
    <PackageReference Include="Grpc.Net.Client" />
  </ItemGroup>

  <!-- Content for the embedded static-file source. Serving assets out of the assembly is the
       packaged-app case, and it cannot be tested without a real embedded resource. -->
  <ItemGroup>
    <EmbeddedResource Include="TestAssets/**" />
  </ItemGroup>

  <!-- The same assets again, zipped, for ZipFileSource's embedded case - the shape a packaged app
       actually ships when its web assets are a publish output rather than a handful of files.
       Zipped by the build instead of committed: a binary checked in beside the folder it was made
       from is one that drifts from it silently. -->
  <ItemGroup>
    <TestAssetFile Include="TestAssets/**" />
  </ItemGroup>

  <!-- $(IntermediateOutputPath) is written by the SDK's targets, which are imported after this file
       is read - so the path is built inside the targets below, where it is set, rather than in a
       property group up here where it would still be empty and drop the archive in the project
       root. -->
  <Target Name="ZipTestAssets"
          BeforeTargets="PrepareForBuild"
          Inputs="@(TestAssetFile)"
          Outputs="$(IntermediateOutputPath)Assets.zip">
    <!-- PrepareForBuild is what creates obj/$(Configuration)/$(TargetFramework), and this runs
         before it - so on a clean tree the directory the archive goes in does not exist yet. -->
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <ZipDirectory SourceDirectory="$(MSBuildThisFileDirectory)TestAssets"
                  DestinationFile="$(IntermediateOutputPath)Assets.zip"
                  Overwrite="true" />
  </Target>

  <!-- A logical name outside the TestAssets prefix on purpose, so EmbeddedFileSource pointed at
       that namespace does not also find the archive sitting next to the loose copies. -->
  <Target Name="EmbedTestAssetsZip" BeforeTargets="PrepareForBuild" DependsOnTargets="ZipTestAssets">
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)Assets.zip"
                        LogicalName="Shiny.Net.HttpServer.Tests.Assets.zip" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="../../src/Shiny.Net.HttpServer/Shiny.Net.HttpServer.csproj" />
    <ProjectReference Include="../../src/Shiny.Net.HttpServer.Grpc/Shiny.Net.HttpServer.Grpc.csproj" />
    <ProjectReference Include="../../src/Shiny.Net.HttpServer.Jwt/Shiny.Net.HttpServer.Jwt.csproj" />
    <ProjectReference Include="../../src/Shiny.Net.HttpServer.AzureRelay/Shiny.Net.HttpServer.AzureRelay.csproj" />
    <ProjectReference Include="../../src/Shiny.Net.HttpServer.Mcp/Shiny.Net.HttpServer.Mcp.csproj" />
    <ProjectReference Include="../../src/Shiny.Net.HttpServer.Ssh/Shiny.Net.HttpServer.Ssh.csproj" />
    <ProjectReference Include="../../src/Shiny.Net.HttpServer.Tunnels/Shiny.Net.HttpServer.Tunnels.csproj" />
    <ProjectReference Include="../../src/Shiny.Net.HttpServer.Discovery/Shiny.Net.HttpServer.Discovery.csproj" />

    <!-- Only the plain net10.0 slice of the mobile package is reachable from here, and that is the
         point: the lifecycle task itself is inside `#if PLATFORM` and cannot run off a device, but
         the retry policy it drives every start and restart through is ordinary code, and it is the
         part whose failure is a server that never comes back. -->
    <ProjectReference Include="../../src/Shiny.Net.HttpServer.Mobile/Shiny.Net.HttpServer.Mobile.csproj" />
    <ProjectReference Include="../../src/Shiny.Net.HttpServer.Testing/Shiny.Net.HttpServer.Testing.csproj" />
    <ProjectReference Include="../../src/Shiny.Net.HttpServer.WebDav/Shiny.Net.HttpServer.WebDav.csproj" />
    <ProjectReference Include="../../src/Shiny.Net.HttpServer.Mediator/Shiny.Net.HttpServer.Mediator.csproj" />
    <ProjectReference Include="../../src/Shiny.Net.HttpServer.DocumentDb/Shiny.Net.HttpServer.DocumentDb.csproj" />

    <!-- The CLI is an executable, but its argument parsing and its create/update guard are ordinary
         classes, and they are the parts that would rot silently. -->
    <ProjectReference Include="../../src/Shiny.Net.HttpServer.CommandLine/Shiny.Net.HttpServer.CommandLine.csproj" />

    <!-- A real store behind the document endpoints, so the tests exercise the engine rather than a
         stand-in. Test-only, and pinned in lockstep with the engine in Directory.Packages.props: a
         provider compiled against a different engine build is a runtime mismatch, not a build error. -->
    <PackageReference Include="Shiny.DocumentDb.Sqlite" />

    <!-- The mediator generator reaches a consumer through the NuGet package's analyzers/ folder.
         Analyzers do not flow across a ProjectReference, so referencing it in-repo takes the
         explicit route the package does for everyone else. -->
    <ProjectReference Include="../../src/Shiny.Net.HttpServer.Mediator.SourceGenerators/Shiny.Net.HttpServer.Mediator.SourceGenerators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />

    <!-- Both an analyzer and a referenced assembly: the tests exercise the generated output *and*
         the generator's own route-template parser, which has to agree with the runtime one. -->
    <ProjectReference Include="../../src/Shiny.Net.HttpServer.SourceGenerators/Shiny.Net.HttpServer.SourceGenerators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="true" />
  </ItemGroup>

</Project>
